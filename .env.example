# Required for the application to sign in and store data.
# Docker Compose publishes PostgreSQL on port 5432.
# `npm run db:start` listens on port 5433. Use that port in DATABASE_URL when Docker is not running.
DATABASE_URL=postgresql://findmail:findmail@127.0.0.1:5432/findmail
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000

# Required for background jobs. The web app starts without Redis, but discovery, import, email finding, verification, and export stay queued until Redis and the worker are running.
REDIS_URL=redis://127.0.0.1:6379

# Required only for YouTube discovery and for resolving video URLs or handles during CSV import.
YOUTUBE_API_KEY=

# Optional. The app starts without these. Nothing is marked verified or fetched from a contact vendor until both the provider and key are set.
# EMAIL_VERIFICATION_PROVIDER: none | zerobounce | neverbounce
EMAIL_VERIFICATION_PROVIDER=none
EMAIL_VERIFICATION_API_KEY=
# CONTACT_PROVIDER: none | hunter
CONTACT_PROVIDER=none
CONTACT_SEARCH_API_KEY=

# Tuning. Defaults are used when these are omitted.
MAX_PAGES_PER_DOMAIN=10
REQUEST_TIMEOUT_MS=10000
MAX_CONCURRENT_JOBS=5
YOUTUBE_DAILY_QUOTA=10000
MAX_UPLOAD_BYTES=5242880
DOMAIN_REQUEST_INTERVAL_MS=1000

# Local seed only. Do not use a weak password outside your machine.
SEED_ADMIN_EMAIL=admin@wayoads.local
SEED_ADMIN_PASSWORD=

# Server-to-server key for Wayo Ads. Send it as: Authorization: Bearer <key>
WAYO_ADS_API_KEY=

# Auth.js behind a reverse proxy
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
