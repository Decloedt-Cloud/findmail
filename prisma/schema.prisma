generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum DiscoverySource {
  YOUTUBE_SEARCH
  CSV_IMPORT
  MANUAL
}

enum WebsiteStatus {
  UNKNOWN
  FOUND
  UNAVAILABLE
}

enum SubscriberVisibility {
  PUBLIC
  HIDDEN
  UNAVAILABLE
}

enum EmailSearchStatus {
  NOT_SEARCHED
  NOT_FOUND
  FOUND
  NEEDS_REVIEW
}

enum EmailVerificationStatus {
  DISCOVERED
  SYNTAX_VALID
  VERIFIED
  INVALID
  UNKNOWN
  NOT_FOUND
  NEEDS_REVIEW
}

enum ConfidenceStatus {
  HIGH
  MEDIUM
  LOW
  AMBIGUOUS
}

enum EmailSourceType {
  PUBLIC_PAGE
  MAILTO
  CHANNEL_DESCRIPTION
  CSV_IMPORT
  LICENSED_PROVIDER
  MANUAL
}

enum ExtractionMethod {
  MAILTO_LINK
  VISIBLE_TEXT
  CHANNEL_DESCRIPTION
  CSV_COLUMN
  PROVIDER_API
  MANUAL
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  DISCOVER_CREATORS
  IMPORT_CHANNELS
  DISCOVER_WEBSITES
  FIND_CONTACT_PAGES
  EXTRACT_EMAILS
  VERIFY_EMAILS
  EXPORT_RESULTS
  MATCH_ICP_CHANNELS
}

enum ExportScope {
  FILTERED
  SELECTED
  WITH_EMAIL
  VERIFIED_ONLY
  WITHOUT_EMAIL
  JOB
  CONTACT_LIST
}

enum DuplicateStrategy {
  SKIP
  UPDATE
  MERGE
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  role         UserRole       @default(MEMBER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  auditEvents  AuditEvent[]
  exports      ExportRecord[]
  imports      ImportBatch[]
  jobs         ProcessingJob[]
  lists        ContactList[]
  searchJobs   SearchJob[]
}

model Creator {
  id                   String                @id @default(cuid())
  youtubeChannelId     String                @unique
  channelName          String
  channelHandle        String?
  channelUrl           String
  description          String?               @db.Text
  country              String?
  discoveryRegion      String?
  language             String?
  subscriberCount      Int?
  subscriberVisibility SubscriberVisibility  @default(UNAVAILABLE)
  videoCount           Int?
  viewCount            BigInt?
  thumbnailUrl         String?
  officialWebsiteUrl   String?
  websiteStatus        WebsiteStatus         @default(UNKNOWN)
  websiteEvidence      String?               @db.Text
  keywords             String[]
  discoverySource      DiscoverySource       @default(YOUTUBE_SEARCH)
  emailSearchStatus    EmailSearchStatus     @default(NOT_SEARCHED)
  recentVideoPublishedAt DateTime?
  lastActiveAt         DateTime?
  averageViews         Int?
  averageViewsMethod   String?
  instagramUrl         String?
  twitterUrl           String?
  tiktokUrl            String?
  matchedVideoTitle    String?
  matchedVideoUrl      String?
  matchedVideoViews    Int?
  matchedVideoPublishedAt DateTime?
  channelIcp           Json?
  relevanceScore       Int                   @default(0)
  hidden               Boolean               @default(false)
  discoveredAt         DateTime              @default(now())
  lastMetadataSyncAt   DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  emails               EmailContact[]
  listMembers          ContactListMember[]
  jobItems             JobItem[]
  icpChannels          IcpChannelMatch[]

  @@index([country])
  @@index([subscriberCount])
  @@index([discoveredAt])
  @@index([hidden])
  @@index([emailSearchStatus])
  @@index([discoverySource])
}

model EmailContact {
  id                   String                  @id @default(cuid())
  creatorId            String
  creator              Creator                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  emailAddress         String
  normalizedEmail      String
  sourceUrl            String?
  sourceType           EmailSourceType
  extractionMethod     ExtractionMethod
  confidenceStatus     ConfidenceStatus        @default(MEDIUM)
  verificationStatus   EmailVerificationStatus @default(DISCOVERED)
  verificationProvider String?
  verifiedAt           DateTime?
  isOnOfficialDomain   Boolean                 @default(false)
  isGenericInbox       Boolean                 @default(false)
  pageTitle            String?
  provenanceNote       String?
  discoveredAt         DateTime                @default(now())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([creatorId, normalizedEmail])
  @@index([normalizedEmail])
  @@index([verificationStatus])
  @@index([discoveredAt])
}

model SearchJob {
  id                  String         @id @default(cuid())
  name                String
  keywords            String[]
  countries           String[]
  language            String?
  minSubscribers      Int?
  maxSubscribers      Int?
  maxResults          Int            @default(50)
  requirePublicEmail  Boolean        @default(false)
  recencyDays         Int?
  status              JobStatus      @default(QUEUED)
  progress            Int            @default(0)
  totalRecords        Int            @default(0)
  processedRecords    Int            @default(0)
  successCount        Int            @default(0)
  noEmailCount        Int            @default(0)
  failureCount        Int            @default(0)
  duplicatesPrevented Int            @default(0)
  quotaUsed           Int            @default(0)
  nextPageToken       String?
  errorSummary        String?        @db.Text
  retryCount          Int            @default(0)
  cancelRequested     Boolean        @default(false)
  userId              String?
  user                User?          @relation(fields: [userId], references: [id])
  processingJobId     String?        @unique
  processingJob       ProcessingJob? @relation(fields: [processingJobId], references: [id])
  createdAt           DateTime       @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ProcessingJob {
  id                  String        @id @default(cuid())
  type                JobType
  name                String
  status              JobStatus     @default(QUEUED)
  progress            Int           @default(0)
  totalRecords        Int           @default(0)
  processedRecords    Int           @default(0)
  successCount        Int           @default(0)
  noEmailCount        Int           @default(0)
  failureCount        Int           @default(0)
  duplicatesPrevented Int           @default(0)
  errorSummary        String?       @db.Text
  payload             Json
  bullJobId           String?
  retryCount          Int           @default(0)
  maxAttempts         Int           @default(3)
  cancelRequested     Boolean       @default(false)
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  createdAt           DateTime      @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime      @updatedAt
  errors              JobError[]
  items               JobItem[]
  searchJob           SearchJob?
  importBatch         ImportBatch?
  exportRecord        ExportRecord?
  brandIcp            BrandIcp?

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

model JobItem {
  id          String        @id @default(cuid())
  jobId       String
  job         ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  creatorId   String?
  creator     Creator?      @relation(fields: [creatorId], references: [id])
  externalKey String
  status      JobStatus     @default(QUEUED)
  attempts    Int           @default(0)
  lastError   String?
  result      Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([jobId, externalKey])
  @@index([jobId, status])
}

model JobError {
  id        String        @id @default(cuid())
  jobId     String
  job       ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recordKey String?
  message   String
  retryable Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([jobId])
}

model ImportBatch {
  id                String            @id @default(cuid())
  fileName          String
  storedFilePath    String
  status            JobStatus         @default(QUEUED)
  duplicateStrategy DuplicateStrategy @default(SKIP)
  columnMapping     Json
  totalRows         Int               @default(0)
  processedRows     Int               @default(0)
  successCount      Int               @default(0)
  errorCount        Int               @default(0)
  duplicateCount    Int               @default(0)
  errorReportPath   String?
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  processingJobId   String?           @unique
  processingJob     ProcessingJob?    @relation(fields: [processingJobId], references: [id])
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  updatedAt         DateTime          @updatedAt
}

model ExportRecord {
  id              String         @id @default(cuid())
  scope           ExportScope
  fileName        String
  filePath        String?
  status          JobStatus      @default(QUEUED)
  rowCount        Int            @default(0)
  filters         Json?
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  processingJobId String?        @unique
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id])
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  @@index([createdAt])
  @@index([userId])
}

model ContactList {
  id        String              @id @default(cuid())
  name      String
  notes     String?             @db.Text
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  members   ContactListMember[]

  @@index([userId])
  @@index([name])
}

model ContactListMember {
  id        String      @id @default(cuid())
  listId    String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([listId, creatorId])
  @@index([creatorId])
}

model ApiUsage {
  id        String   @id @default(cuid())
  provider  String
  operation String
  units     Int
  success   Boolean
  message   String?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model DedupEvent {
  id        String   @id @default(cuid())
  kind      String
  key       String
  source    String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Simplified advertiser ICP received from Wayo Ads, plus the channels found for it.
model BrandIcp {
  id                  String         @id @default(cuid())
  wayoOnboardingId    String
  websiteUrl          String
  brandName           String
  snapshot            Json
  searchQueries       String[]
  analysisNote        String?        @db.Text
  status              JobStatus      @default(QUEUED)
  matchedChannelCount Int            @default(0)
  errorSummary        String?        @db.Text
  processingJobId     String?        @unique
  processingJob       ProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  channels            IcpChannelMatch[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([wayoOnboardingId])
  @@index([websiteUrl])
  @@index([status])
  @@index([createdAt])
}

/// A YouTube channel kept for one simplified ICP. The video search is not stored.
model IcpChannelMatch {
  id         String   @id @default(cuid())
  brandIcpId String
  brandIcp   BrandIcp @relation(fields: [brandIcpId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([brandIcpId, creatorId])
  @@index([creatorId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
